<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProyectoGrado.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR para CQRS (comandos/queries) y FluentValidation para validaciones -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <!--
    Application depende SOLO de Domain.
    Aqui van: Commands, Queries, Handlers (MediatR), Validators, DTOs,
    interfaces de servicios externos (IPaymentProvider, IWhatsAppService, etc.)
    que Infrastructure implementara.
  -->

</Project>
